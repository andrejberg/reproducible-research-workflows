#!/bin/bash
# Repo2Docker runs this every time a session starts.
# On Jupyter4NFDI with "Mount user data", only ~/work is kept between sessions. Your Git
# settings (name and email from `git config --global`) go there, so they survive a
# restart. Conda environments and the kernels you register stay on the local disk: the
# work folder is slow with many small files, and an installed environment has thousands.
# Keep the environment file in ~/work and rebuild the environment from it after a restart.
export GIT_CONFIG_GLOBAL="$HOME/work/.gitconfig"

exec "$@"
